// Secrets.dev.xcconfig.example — modèle pour la configuration « Dev » (#456)
//
// Copier en `Secrets.dev.xcconfig` (gitignoré) et renseigner.
//
//     cp ArboreUi/Secrets.dev.xcconfig.example ArboreUi/Secrets.dev.xcconfig
//
// Puis sélectionner le schéma « ArboreUi Dev » dans Xcode avant de lancer sur
// l'appareil.

// Backend de développement. Le TLD .app impose HSTS preload : URLSession
// refuserait tout HTTP, donc https obligatoire même hors production.
ARBORE_BACKEND_PROTOCOL = https
ARBORE_BACKEND_HOST = api-dev.arbore.app

// Clé du gate backend — celle que le backend de DEV accepte :
//     sops ops/secrets/dev.enc.env      → ARBORE_API_KEY
//
// Pas ARBORE_API_KEY_TEST de la production : même valeur aujourd'hui, mais ce
// sont deux réglages indépendants.
ARBORE_API_KEY =

// Sentry — laisser VIDE en dev. Sans DSN, Sentry ne démarre pas et les
// événements de test ne polluent pas les rapports de production.
SENTRY_DSN_PUBLIC_KEY =
SENTRY_DSN_HOST =
SENTRY_DSN_PROJECT_ID =
