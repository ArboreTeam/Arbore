// Secrets.xcconfig.example
// Copier ce fichier en Secrets.xcconfig et remplir les valeurs

// === SÉCURITÉ ===
// Clé API pour authentifier l'application iOS auprès du backend
// ⚠️ Cette clé DOIT être identique à celle du backend (ARBORE_API_KEY)
// ⚠️ Ne JAMAIS commit Secrets.xcconfig dans Git
ARBORE_API_KEY = arbore_ios_v1_VOTRE_CLE_ICI

// === BACKEND ===
// Protocole du backend (http ou https)
ARBORE_BACKEND_PROTOCOL = https

// Host du backend (IP:port ou domaine:port). Production = api.arbore.app
// (HTTPS via Cloudflare). Pour du dev local hors VPS, basculer en
// http + 79.137.92.154:8080 ; l'exception ATS dans Info.plist autorise
// ce host précis.
ARBORE_BACKEND_HOST = api.arbore.app
