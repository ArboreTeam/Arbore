# Sources CocoaPods
source 'https://cdn.cocoapods.org/'

# Platform iOS minimum
platform :ios, '13.0'

# Updated 2026-01-26: CocoaPods 1.16.2 + Xcode 16.2 + iPhone 16 Pro simulator

use_frameworks!
inhibit_all_warnings!

# La configuration « Dev » (#456) doit être DÉCLARÉE ici, sinon CocoaPods ne
# crée pas de configuration correspondante dans le projet Pods : ses cibles se
# construisent alors ailleurs que dans `Dev-iphoneos`, et le link échoue sur
#
#     ld: framework 'Pods_ArboreUi' not found
#
# Inclure `Pods-ArboreUi.debug.xcconfig` depuis `Dev.xcconfig` ne suffit pas :
# un xcconfig décrit comment compiler, il ne fait pas construire les CIBLES de
# Pods pour une configuration qu'elles n'ont pas.
#
# `=> :debug` dit à CocoaPods de traiter « Dev » comme Debug — mêmes symboles,
# mêmes optimisations désactivées. C'est exactement ce que `Dev.xcconfig`
# annonce de son côté.
project 'ArboreUi.xcodeproj', 'Dev' => :debug

target 'ArboreUi' do
  # Firebase et GoogleSignIn sont gérés via Swift Package Manager (voir project.pbxproj).
  #
  # Facebook SDK retiré (issue #204) : l'audit a montré qu'il était vestigial —
  # aucun appel FBSDK/LoginKit dans le code, aucun FacebookAppID ni URL scheme
  # dans Info.plist (il ne pouvait donc pas fonctionner), et la connexion se fait
  # via email / Google / Apple. Apple traite ces SDK comme du tracking par défaut :
  # les supprimer évite un prompt ATT et garde NSPrivacyTracking = false.
  # Aucune dépendance CocoaPods restante à ce jour.
end

# post_install minimal et sur
post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Si simulateur Apple Silicon pose souci, decommente :
      # config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
    end
  end
end
