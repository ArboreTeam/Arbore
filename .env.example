# Docker Compose production configuration.
# Copy to .env, replace every placeholder, then keep the resulting file at 0600.
#
# 📌 Canonical env reference for the whole stack (backend + ai-generator + web).
# Component-level files (e.g. ArboreBackend/.env.example) only add what a
# standalone run needs on top of this; shared secrets are documented here only.

BIND_ADDRESS=127.0.0.1
PORT=8080
WEB_PORT=3000

# Persistent production data. Absolute paths let releases use a clean checkout
# without copying or deleting server-generated assets.
MODELS_HOST_PATH=./ArboreBackend/models
THUMBNAILS_HOST_PATH=./ArboreBackend/models/thumbnails
LEGACY_COMMUNITY_UPLOADS_HOST_PATH=./ArboreBackend/uploads/community
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./arbore-firebase-adminsdk.json

MONGODB_URI=
MONGODB_URI_TEST=
ARBORE_API_KEY=
ARBORE_API_KEY_TEST=
ARBORE_ADMIN_UIDS=

# Clé maître AES-256 (64 caractères hex) chiffrant les refresh tokens Apple.
#
# Deux sources possibles, le FICHIER étant préféré : une variable d'environnement
# est lisible via `docker inspect` et `/proc/<pid>/environ`, alors que cette clé
# déchiffre justement les tokens Apple (audit #338 constat 4).
#
# Pour basculer sur le fichier — recommandé en production :
#   1. écrire la clé (64 hex, sans retour à la ligne obligatoire) dans un fichier
#      hors du dépôt, ex. /home/fedora/arbore-data/master-encryption.key, en 0600
#   2. MASTER_ENCRYPTION_KEY_HOST_PATH = ce chemin
#   3. MASTER_ENCRYPTION_KEY_PATH = /run/secrets/master-encryption.key
#   4. vider MASTER_ENCRYPTION_KEY (le fichier suffit)
#
# Laisser MASTER_ENCRYPTION_KEY_PATH vide conserve le comportement historique
# (lecture de la variable ci-dessous). Un MASTER_ENCRYPTION_KEY_PATH défini mais
# illisible est une ERREUR, pas un repli silencieux.
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_PATH=
MASTER_ENCRYPTION_KEY_HOST_PATH=/dev/null

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIWA_CLIENT_ID=com.arboreteam.arbore
APPLE_SIWA_KEY_HOST_PATH=./AuthKey_XXXXXXXXXX.p8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
UNSPLASH_ACCESS_KEY=

AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Origines autorisées à appeler l'API depuis un NAVIGATEUR (liste séparée par des
# virgules). Vide = CORS désactivé, aucune requête cross-origin acceptée.
#
# Laisser vide est le bon réglage en production : l'app web n'appelle pas l'API
# depuis le navigateur mais via son propre proxy Next.js côté serveur
# (web/app/api/backend/[...path]/route.ts), où CORS ne s'applique pas.
# À ne remplir que pour un client réellement navigateur (audit #338 constat 5).
CORS_ALLOWED_ORIGINS=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production
NEXT_PUBLIC_APP_VERSION=1.0.0
