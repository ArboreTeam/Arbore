# Les secrets (ARBORE_API_KEY, clés Firebase, SENTRY_AUTH_TOKEN) passent par
# l'environnement de déploiement et restent hors git via .env*.local.
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
