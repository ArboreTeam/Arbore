# Configuration Frontend Arbore
# Copier ce fichier en .env.local et remplir les valeurs

# === FIREBASE ===
# Récupérer depuis Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=votre_api_key_ici
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=votre_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=votre_app_id

# === BACKEND API (SERVEUR uniquement — surtout PAS de préfixe NEXT_PUBLIC_) ===
# Ces deux variables sont lues côté serveur par le proxy
# app/api/backend/[...path]/route.ts et ne sont JAMAIS envoyées au navigateur.
# Le client appelle /api/backend/... (same-origin), le proxy ajoute la clé API.
#
# URL du backend Go (local ou VPS)
BACKEND_API_URL=http://localhost:8080
# ⚠️ Doit être identique à ARBORE_API_KEY dans ArboreBackend/.env
ARBORE_API_KEY=votre_cle_api_ici

# === SENTRY (observabilité — optionnel) ===
# Sans DSN, Sentry est un no-op (aucune donnée envoyée). Privacy-first : pas de PII,
# pas de Session Replay. DSN public (navigateur) :
NEXT_PUBLIC_SENTRY_DSN=
# Environnement remonté (ex. production, beta). Défaut : NODE_ENV.
NEXT_PUBLIC_SENTRY_ENV=
# Upload des source maps au build (CI/prod uniquement — NE PAS committer le token) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
