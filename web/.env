# Config PUBLIQUE du front web (committée).
# Toutes ces variables NEXT_PUBLIC_* sont, par conception, embarquées dans le
# bundle navigateur — ce ne sont PAS des secrets. La sécurité Firebase repose sur
# les Authorized domains + Security Rules (pas sur le masquage de l'apiKey).
#
# Les VRAIS secrets restent hors git (.env*.local ou env de déploiement) :
#   ARBORE_API_KEY (gate backend), service-account Firebase ADMIN, SENTRY_AUTH_TOKEN.

# === Firebase — app Web "Arbore Web" (projet arbore-b1986) ===
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB_ug1Nbt-Uoq_1knOA0fEScUghxs69S0M
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=arbore-b1986.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=arbore-b1986
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=arbore-b1986.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=66927287937
NEXT_PUBLIC_FIREBASE_APP_ID=1:66927287937:web:be3275c52236113c6e7780
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-8T6261WKS3

# === Sentry — DSN public (navigateur), identique en local et en prod ===
NEXT_PUBLIC_SENTRY_DSN=https://cb706774dbec3ec705a65fa748c35c8c@o4511095262216192.ingest.de.sentry.io/4511526618136656
# Vide -> dérive automatiquement de NODE_ENV (development en local, production au build).
NEXT_PUBLIC_SENTRY_ENV=
