# Sources CocoaPods
source 'https://cdn.cocoapods.org/'

# Platform iOS minimum — ALIGNÉE sur celle de l'app.
#
# Elle valait 13.0 alors que `project.pbxproj` dit 18.2 partout (9 cibles sur
# 9). La contradiction est restée invisible tant que Xcode acceptait 13.0 ;
# le SDK iOS 27.1 ne descend plus sous 15.0 et refuse d'archiver :
#
#     Pods.xcodeproj: error: The iOS deployment target
#     'IPHONEOS_DEPLOYMENT_TARGET' is set to 13.0, but the range of supported
#     deployment target versions is 15.0 to 27.1.x (in target 'Pods-ArboreUi')
#
# Les constructions SIMULATEUR passaient encore, parce qu'elles réutilisaient
# une description de build mise en cache ; seule une archive propre révélait
# le défaut. Autrement dit : ce n'est pas une régression, c'est une dette que
# la montée de version a rendue bloquante.
platform :ios, '18.2'

use_frameworks!
inhibit_all_warnings!

# La configuration « Dev » (#456) doit être DÉCLARÉE ici, sinon CocoaPods ne
# crée pas de configuration correspondante dans le projet Pods : ses cibles se
# construisent alors ailleurs que dans `Dev-iphoneos`, et le link échoue sur
#
#     ld: framework 'Pods_ArboreUi' not found
#
# Inclure `Pods-ArboreUi.debug.xcconfig` depuis `Dev.xcconfig` ne suffit pas :
# un xcconfig décrit comment compiler, il ne fait pas construire les CIBLES de
# Pods pour une configuration qu'elles n'ont pas.
#
# `=> :debug` dit à CocoaPods de traiter « Dev » comme Debug — mêmes symboles,
# mêmes optimisations désactivées. C'est exactement ce que `Dev.xcconfig`
# annonce de son côté.
project 'ArboreUi.xcodeproj', 'Dev' => :debug

target 'ArboreUi' do
  # Firebase et GoogleSignIn sont gérés via Swift Package Manager (voir project.pbxproj).
  #
  # Facebook SDK retiré (issue #204) : l'audit a montré qu'il était vestigial —
  # aucun appel FBSDK/LoginKit dans le code, aucun FacebookAppID ni URL scheme
  # dans Info.plist (il ne pouvait donc pas fonctionner), et la connexion se fait
  # via email / Google / Apple. Apple traite ces SDK comme du tracking par défaut :
  # les supprimer évite un prompt ATT et garde NSPrivacyTracking = false.
  # Aucune dépendance CocoaPods restante à ce jour.
end

# post_install : une seule chose, et la MÊME valeur que l'app.
#
# CocoaPods écrit sa propre cible de déploiement dans le projet Pods, sans
# regarder celle de l'app. La forcer ici est donc nécessaire — mais la forcer
# à une valeur INFÉRIEURE à celle de l'app n'apporte rien : aucune cible de
# l'app ne descend sous 18.2, et plus aucun pod n'est déclaré depuis le
# retrait de Facebook (#204). `Podfile.lock` ne liste aucune dépendance.
DEPLOYMENT_TARGET = '18.2'

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = DEPLOYMENT_TARGET
    end
  end
end
