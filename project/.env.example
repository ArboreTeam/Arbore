# Configuration Frontend Arbore
# Copier ce fichier en .env.local et remplir les valeurs

# === FIREBASE ===
# Récupérer depuis Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=votre_api_key_ici
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=votre_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=votre_app_id

# === BACKEND API ===
# URL du backend Go (local ou VPS)
NEXT_PUBLIC_API_URL=http://localhost:8080
# ⚠️ Doit être identique à ARBORE_API_KEY dans ArboreBackend/.env
NEXT_PUBLIC_ARBORE_API_KEY=votre_cle_api_ici
