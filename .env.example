# Docker Compose production configuration.
# Copy to .env, replace every placeholder, then keep the resulting file at 0600.

BIND_ADDRESS=127.0.0.1
PORT=8080
WEB_PORT=3000

# Persistent production data. Absolute paths let releases use a clean checkout
# without copying or deleting server-generated assets.
MODELS_HOST_PATH=./ArboreBackend/models
THUMBNAILS_HOST_PATH=./ArboreBackend/models/thumbnails
LEGACY_COMMUNITY_UPLOADS_HOST_PATH=./ArboreBackend/uploads/community
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./arbore-firebase-adminsdk.json

MONGODB_URI=
MONGODB_URI_TEST=
ARBORE_API_KEY=
ARBORE_API_KEY_TEST=
ARBORE_ADMIN_UIDS=

MASTER_ENCRYPTION_KEY=

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIWA_CLIENT_ID=com.arboreteam.arbore
APPLE_SIWA_KEY_HOST_PATH=./AuthKey_XXXXXXXXXX.p8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
UNSPLASH_ACCESS_KEY=

AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production
NEXT_PUBLIC_APP_VERSION=1.0.0
