# 🌱 Arbore - .gitignore

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Xcode
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
Secrets.xcconfig

# Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# CocoaPods
Pods/
*.lock
!Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
vendor/
main
main-*
ArboreBackend/ArboreBackend

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
*.log

# IDEs
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Node (si utilisé)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Env files
.env
.env.local
.env.*.local
# Exception : config web PUBLIQUE committée (DSN Sentry, etc. — aucun secret).
!web/.env
*.key
*.pem
secrets/

# Docker
.dockerignore
# Exception : le .dockerignore du web est suivi (build Docker léger sur le VPS).
!web/.dockerignore

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Backup files
*.bak
*.backup
*.tmp
*.temp

# Test coverage
coverage/
*.coverprofile
coverage.out
coverage.xml
.nyc_output/

# CI/CD temp files
.github/workflows/*.tmp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Firebase
**/GoogleService-Info.plist
firebase-debug.log
.firebase/
arbore-firebase-adminsdk.json
*-firebase-adminsdk-*.json

# Certificates & Keys
*.p12
*.mobileprovision
*.certSigningRequest
*.p8

# Fastlane — never commit the App Store Connect API key or any local
# fastlane state (only the Fastfile + Appfile + READMEs are tracked).
fastlane/AuthKey.json
fastlane/AuthKey*.json
fastlane/AuthKey*.p8
fastlane/report.xml

# Sentry CLI auth token (dSYM upload) — never commit. Cf .sentryclirc.example
.sentryclirc
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/builds
fastlane/.env
fastlane/.env.local
# App Review demo-account credentials (#206) — never commit the demo password.
# The marketing metadata (descriptions/keywords/…) IS tracked; only the
# review_information/ folder (demo_user / demo_password / notes) is excluded.
fastlane/metadata/review_information/

# Backup files — never ship in the bundle, never commit.
*.bak

# Bundler — gems sont installés en local au projet (vendor/bundle,
# déjà couvert par `vendor/` plus haut). `.bundle/` contient la config
# locale `bundle config set --local path 'vendor/bundle'`.
.bundle/

# Deepl translations — API key + its backups, never commit
.deepl_api
.deepl_api.backups/
backups/

# CoreML model bundles — too large to commit (DETR Semantic Seg = 86 MB).
# Auto-fetched by scripts/fetch-ml-models.sh via the Xcode Run Script
# build phase, then auto-included by PBXFileSystemSynchronizedRootGroup
# (cf ArboreUi/ArboreUi/ARGarden/SceneUnderstanding/README.md).
*.mlpackage/
*.mlmodelc/

# Local backups + Claude Code project config — never commit.
.backups/
.claude/
