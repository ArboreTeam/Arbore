# Copier en `prod.tfvars` et renseigner. Les valeurs réelles ne sont PAS
# versionnées (cf. infra/.gitignore) ; seul ce modèle l'est, sur le principe
# déjà retenu pour ops/secrets/env.template : l'inventaire dans git, les valeurs
# dehors.
#
# Le jeton n'est PAS ici : il passe par TF_VAR_cloudflare_api_token, pour ne
# jamais transiter par un fichier ni par la ligne de commande.

environment = "prod"
domain      = "arbore.app"

api_hostname = "api.arbore.app"
web_hostname = "web.arbore.app"

# IPv4 de l'origine. Doit rester derrière le proxy Cloudflare : le pare-feu
# d'origine n'accepte que les plages Cloudflare sur :80.
origin_ip = ""

# Vide = dev suit la production, ce qui est le cas normal. Ne la renseigner que
# pour détacher `api-dev` le temps d'une migration de VPS (#652) : ça éprouve
# toute la chaîne Cloudflare contre une machine neuve sans déplacer le trafic
# réel. À remettre vide une fois la bascule complète faite.
dev_origin_ip = ""

cloudflare_account_id = ""
cloudflare_zone_id    = ""

r2_bucket_name  = "arbore-assets"
r2_jurisdiction = "eu"

# Noms d'hôte de l'environnement de dev, sur la même machine (#434).
enable_dev_hostnames = true
